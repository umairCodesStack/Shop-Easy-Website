
@using System.Globalization
@using Domain.DTOs

@code {
    [Parameter]
    public List<GetProductDTO> Products { get; set; }

    private decimal total => Products.Sum(p => p.Price);
    private decimal shipping => 0; 

    private void Increment(GetProductDTO product)
    {
        product.StockQuantity++;
        product.Price = product.Price * product.StockQuantity;
    }

    private void Decrement(GetProductDTO product)
    {
        if (product.StockQuantity > 1)
        {
            product.StockQuantity--;
            product.Price = product.Price * product.StockQuantity;
        }
    }

    private void Remove(GetProductDTO product)
    {
        Products.Remove(product);
    }
}

<div class="container py-5">
    <h2 class="fw-bold" style="color:#FF6600;">Shopping Cart</h2>
    <div class="cart-container row">
        <!-- Cart Items Section -->
        <div class="cart-items col-md-8">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                <h4>Items in Cart</h4>
            </div>

            @foreach (var item in Products)
            {
                    <div class="d-flex align-items-center justify-content-between mb-3 p-3 bg-white rounded shadow-sm">
                        <img src="@item.ImageUrls[0]" width="80" height="80" class="rounded" alt="Product">
                        <div>
                            <h5 class="mb-1">@item.Name</h5>
                            <p class="text-muted">$@item.Price.ToString("F2")</p>
                        </div>
                        <div class="d-flex align-items-center">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Decrement(item)">
                                <i class="fas fa-minus"></i>
                            </button>
                            <input type="text" class="form-control w-25 mx-2 text-center" value="@item.StockQuantity" readonly />
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Increment(item)">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                        <button class="btn btn-outline-danger" @onclick="() => Remove(item)">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
            }
        </div>

        <!-- Cart Summary Section -->
        <div class="cart-summary col-md-4">
            <h4 class="fw-bold">Summary</h4>
            <hr />

            @foreach (var item in Products)
            {
                    <p class="d-flex justify-content-between">
                        <span>@item.StockQuantity x @item.Name:</span>
                        <span>$@item.Price.ToString("F2")</span>
                    </p>
            }

            <p class="d-flex justify-content-between">
                <span>Subtotal:</span>
                <span>$@total.ToString("F2")</span>
            </p>

            <p class="d-flex justify-content-between">
                <span>Shipping:</span>
                <span>$@shipping.ToString("F2")</span>
            </p>

            <hr />
            <h5 class="d-flex justify-content-between fw-bold">
                <span>Total:</span>
                <span>$@(total + shipping).ToString("F2")</span>
            </h5>

            <button class="btn btn-custom mt-3">Proceed to Checkout</button>
            <a href="/Home/HomePage" class="btn btn-outline-custom mt-2">Continue Shopping</a>
        </div>
    </div>
</div>

<style>
    .cart-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }
    .cart-items {
        flex: 2;
        background: #f4f4f4;
        padding: 20px;
        border-radius: 10px;
    }
    .cart-summary {
        flex: 1;
        background: white;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
    .btn-custom {
        background-color: #ff9900;
        color: white;
        border-radius: 50px;
        padding: 12px 22px;
        border: none;
        width: 100%;
    }
    .btn-custom:hover {
        background-color: #e68000;
    }
    .btn-outline-custom {
        border: 2px solid #ff9900;
        color: #ff9900;
        border-radius: 50px;
        padding: 12px 22px;
        width: 100%;
    }
    .btn-outline-custom:hover {
        background-color: #ff9900;
        color: white;
    }
</style>
