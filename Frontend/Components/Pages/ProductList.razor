@using Domain.DTOs
@using Frontend.Services
@inject CartService cartService

<style>
    .product-img {
    width: 100%;
    height: 220px;
    background-size: cover;
    background-position: center;
    border-top-left-radius: 0.375rem;
    border-top-right-radius: 0.375rem;
    }

    .card:hover {
    transform: scale(1.02);
    transition: all 0.3s ease-in-out;
    }

    .icon-btn {
    margin-top: -10px;
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    gap: 10px;
    padding: 0;
    }

    .icon-btn a,
    .icon-btn button {
    background: none;
    border: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition: all 0.3s ease-in-out;
    text-decoration: none;
    color: #333;
    font-size: 20px;
    }

    .icon-btn a:hover i,
    .icon-btn button:hover i {
    color: #FF6600;
    transform: scale(1.2);
    }
</style>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @if (Products == null || Products.Count == 0)
    {
        <p>No products available.</p>
    }
    else
    {
        @foreach (var product in Products)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <a href="/Home/ProductDetails?ProductId=@product.Id" class="text-decoration-none text-dark">
                        <div class="product-img" style="background-image:url('@product.ImageUrls?.FirstOrDefault()');"></div>

                        <div class="card-body text-center">
                            <h5 class="card-title fw-bold">@product.Name</h5>
                            <p class="card-text text-danger fs-5 fw-semibold">$@product.Price</p>
                            <p class="card-text text-muted">@product.Description</p>

                            <div class="star-rating mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= product.Rating)
                                    {
                                        <i class="fas fa-star text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star text-warning"></i>
                                    }
                                }
                            </div>

                            <div class="icon-btn">
                                <a href="#" title="Like" class="like-icon" onclick="toggleLike(event)">
                                    <i class="far fa-heart"></i>
                                </a>

                                <a href="#" title="Share" class="share-icon" onclick="event.preventDefault();">
                                    <i class="fa-regular fa-paper-plane"></i>
                                </a>

                                <button @onclick="() => AddToCart(product.Id)" class="cart-icon">
                                    <i class="fas fa-shopping-cart"></i>
                                </button>

                                <a href="#" title="Chat" class="chat-icon" onclick="event.preventDefault();">
                                    <i class="fas fa-comment-dots"></i>
                                </a>
                            </div>

                        </div>
                    </a>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public List<GetProductDTO> Products { get; set; }
    private async Task AddToCart(int productId)
    {
        var item = new AddToCartDTO
            {
                cartItem=new AddCartItemDTO
                {
                    productId=productId,
                    quantity=1
                }
            };

        try
        {
            await cartService.AddToCartAsync(item);
            Console.WriteLine("Product added to cart successfully.");
            // Optionally show a success message to user
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding product to cart: {ex.Message}");
            // Optionally show error message to user
        }
    }

}
