@page "/signup"
@using System.ComponentModel.DataAnnotations
@using Frontend.Services
@inject  AccountService UserService
@inject NavigationManager NavigationManager

<style>
    .btn-google, .btn-facebook {
    background-color: white;
    color: black;
    border: 2px solid #ddd;
    display: flex;
    align-items: center;
    justify-content: center;
    }

    .btn-google img, .btn-facebook img {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    }

    .btn-google:hover, .btn-facebook:hover {
    border-color: #ff9900;
    }

    .logo-img {
    width: 80px;
    height: 40px;
    border-radius: 5%;
    }

    .navbar-brand {
    font-weight: bold;
    font-size: 1.5rem;
    }

    .auth-container {
    background: url('/Images/auth_back.jpg') no-repeat center center/cover;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    }

    .auth-card {
    border-radius: 15px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    max-width: 450px;
    width: 100%;
    }
</style>
<Frontend.Components.Shared.AuthNav></Frontend.Components.Shared.AuthNav>
<div class="container-fluid auth-container">
    <div class="card auth-card p-2">
        <div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">


            <EditForm Model="signupModel" OnValidSubmit="HandleSignup" FormName="SignupForm">
                <DataAnnotationsValidator />

                <h3 class="text-center bold" style="color: #ff9900;">Sign Up</h3>

                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <InputText @bind-Value="signupModel.Name" class="form-control" placeholder="Enter your name" />
                    <ValidationMessage For="@(() => signupModel.Name)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText @bind-Value="signupModel.Email" type="email" class="form-control" placeholder="Enter your email" />
                    <ValidationMessage For="@(() => signupModel.Email)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <div class="input-group">
                        <InputText @bind-Value="signupModel.Password" type="@(showPassword ? "text" : "password")" class="form-control" placeholder="Create a password" />
                        <button class="btn btn-outline-secondary" type="button" @onclick="TogglePassword">
                            <i class="fas @(showPassword ? "fa-eye-slash" : "fa-eye")"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => signupModel.Password)" />
                </div>

                <button type="submit" class="btn w-100" style="background-color: #ff9900;" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Signing up...</span>
                    }
                    else
                    {
                        <span>Sign Up</span>
                    }
                </button>

                @if (!string.IsNullOrEmpty(signupError))
                {
                    <div class="alert alert-danger mt-3" role="alert">
                        @signupError
                    </div>
                }
            </EditForm>
        </div>


    </div>
</div>

@code {
    [SupplyParameterFromForm]
    public UserDTO signupModel { get; set; } = new();
    private bool showPassword = false;
    private bool isLoading = false;
    private string signupError = string.Empty;

    private void TogglePassword() => showPassword = !showPassword;
    private async Task HandleSignup() 
    {
        var response = await UserService.CreateUserAsync(signupModel);
        if (response.status)
        {

            NavigationManager.NavigateTo("/");
        }
        else
        {
            // Display error message
            signupError = response.message ?? "An error occurred during signup.";
        }
    }

    
}
